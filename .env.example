# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4444

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
REDIS_URL="rediss://default:gQAAAAAAArH4AAIgcDEzY2I2MTdiNTcyZjQ0OWRlOTk4MGIzNmI1YmNkMDgyZA@rich-raptor-176632.upstash.io:6379"

# ─── Cache ────────────────────────────────────────────────────────────────────
# How long (in seconds) successful stream responses are cached in Redis.
CACHE_TTL=300

# ─── Upstream API ─────────────────────────────────────────────────────────────
BASE_API=https://new.vidnest.fun

# How long (in ms) to wait for an upstream response before aborting.
FETCH_TIMEOUT=15000

# ─── HLS Proxy ────────────────────────────────────────────────────────────────
# Wraps HLS (.m3u8) stream URLs through a reverse proxy.
# Set to empty string to disable: HLS_PROXY=
HLS_PROXY=https://proxy.jpaworx.com/?url=

# ─── Upstream request headers ─────────────────────────────────────────────────
UPSTREAM_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36
UPSTREAM_REFERER=https://vidnest.fun/
UPSTREAM_ORIGIN=https://vidnest.fun

# ─── VidNest custom base64 alphabet ───────────────────────────────────────────
# Only change this if VidNest rotates their alphabet.
VIDNEST_ALPHABET=RB0fpH8ZEyVLkv7c2i6MAJ5u3IKFDxlS1NTsnGaqmXYdUrtzjwObCgQP94hoeW+/=
